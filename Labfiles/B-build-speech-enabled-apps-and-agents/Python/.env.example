# Alpine Ski House - guest services voice lab (Lab B)
# Copy this file to .env and fill in your own values.

# Foundry resource endpoint in Azure AI services form, used by the Azure Speech SDK
# in Task 1 and Task 3.
# Example: https://alpine-resource.cognitiveservices.azure.com/
SPEECH_ENDPOINT=your_speech_endpoint

# Target URI of your text-to-speech model deployment, used in Task 2.
# Copy it from the model details page in the Microsoft Foundry portal.
TTS_MODEL_ENDPOINT=your_tts_model_endpoint
TTS_MODEL_NAME=gpt-4o-mini-tts

# Target URI of your speech-to-text model deployment, used in Task 2.
STT_MODEL_ENDPOINT=your_stt_model_endpoint
STT_MODEL_NAME=gpt-4o-mini-transcribe

# Full Foundry project endpoint, used by the agent client in Task 4.
# Example: https://alpine-resource.services.ai.azure.com/api/projects/alpine-project
PROJECT_ENDPOINT=your_project_endpoint

# The name of the speech agent you create in Task 4 (case-sensitive).
AGENT_NAME=slope-report-agent

# Voice Live settings, used in Task 5. The endpoint ends at the .com domain
# (no "/api/projects/{project_name}" suffix).
# Example: https://alpine-resource.services.ai.azure.com/
VOICELIVE_ENDPOINT=your_voicelive_endpoint
VOICELIVE_PROJECT_NAME=your_project_name
VOICELIVE_AGENT_NAME=concierge-agent
