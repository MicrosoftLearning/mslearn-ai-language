# Alpine Ski House - guest feedback lab (Lab A)
# Copy this file to .env and fill in your own values.

# Foundry resource endpoint, used by the Azure Language SDK in Task 1.
# Copy the project endpoint from the Microsoft Foundry portal and remove the
# "/api/projects/{project_name}" suffix, so it ends at the .com domain.
# Example: https://alpine-resource.services.ai.azure.com
FOUNDRY_ENDPOINT=your_foundry_endpoint

# Foundry resource endpoint in Azure AI services form, used by Azure Translator in Task 2.
# Example: https://alpine-resource.cognitiveservices.azure.com/
TRANSLATOR_ENDPOINT=your_translator_endpoint

# Full Foundry project endpoint, used by the agent client in Task 3.
# Example: https://alpine-resource.services.ai.azure.com/api/projects/alpine-project
PROJECT_ENDPOINT=your_project_endpoint

# The name of the portal agent you create in Task 3 (case-sensitive).
AGENT_NAME=guest-feedback-agent
